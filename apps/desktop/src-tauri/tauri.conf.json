{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VietMath",
  "version": "0.1.0",
  "identifier": "vn.vietmath.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "VietMath",
      "width": 1180,
      "height": 760,
      "minWidth": 760,
      "minHeight": 560,
      "resizable": true
    }],
    "security": { "csp": null }
  },
  "bundle": { "active": false }
}
