{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VietMath",
  "version": "0.1.0",
  "identifier": "vn.vietmath.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VietMath",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true
      },
      {
        "label": "quick",
        "title": "VietMath Quick",
        "url": "index.html?mode=quick",
        "width": 560,
        "height": 330,
        "minWidth": 440,
        "minHeight": 260,
        "resizable": true,
        "visible": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
